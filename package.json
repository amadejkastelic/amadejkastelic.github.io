{
	"name": "portfolio",
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/posts": "./src/lib/posts.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write ./src",
		"lint": "biome lint --write ./src",
		"postinstall": "bun2nix -o nix/bun.nix"
	},
	"dependencies": {
		"@catppuccin/palette": "^1.8.0",
		"@indaco/svelte-iconoir": "^7.11.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"biome": "^0.3.3",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@fontsource/noto-sans": "^5.3.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"bun2nix": "^2.1.2",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"shiki": "^4.5.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4"
	}
}
